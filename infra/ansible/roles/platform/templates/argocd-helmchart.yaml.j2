# {{ ansible_managed }}
apiVersion: helm.cattle.io/v1
kind: HelmChart
metadata:
  name: argocd
  namespace: kube-system
spec:
  repo: https://argoproj.github.io/argo-helm
  chart: argo-cd
  version: {{ platform_argocd_chart_version }}
  targetNamespace: argocd
  createNamespace: true
  valuesContent: |-
    {{ lookup('ansible.builtin.file', platform_repo_dir ~ '/argocd/values.yaml') | indent(4) }}
